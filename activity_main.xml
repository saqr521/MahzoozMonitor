<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:padding="18dp" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:text="Mahzooz Monitor Pro"
            android:textSize="24sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:text="جاهز"
            android:textSize="16sp" android:paddingTop="10dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/start" android:text="ابدأ مراقبة الشاشة"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/stop" android:text="إيقاف المراقبة"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/calibrate" android:text="وضع المعايرة والتعلّم"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/history" android:text="السجل والإحصائيات"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/results" android:text="لم يتم تحليل أي لقطة بعد."
            android:paddingTop="18dp" android:textSize="15sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
